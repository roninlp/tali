{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json",
    "./node_modules/@tali/lint-config/oxlint/strict.json",
    "./node_modules/@tali/lint-config/oxlint/effect.json",
    "./node_modules/@foldkit/oxlint-plugin/recommended.json"
  ],
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "ignoreCase": false
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "public",
    "**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "**/*.config.js",
    "**/*.config.mjs"
  ]
}
