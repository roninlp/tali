# Copy to .env and fill in. The infra package scripts load it automatically for
# `pnpm stack:plan`, `pnpm stack:deploy`, `pnpm stack:destroy` and `pnpm dev`:
#
#   cp .env.example .env
#   pnpm stack:plan
#   pnpm stack:deploy
#
# `.env` is gitignored. The same names are GitHub Actions secrets for the
# deploy-on-push workflow (see infra/README.md).

# Cloudflare account + API token (Workers Scripts, D1, Workers R2 Storage edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The existing Web Push identity. Generate a dev pair with
# `pnpm exec web-push generate-vapid-keys`; a production deploy must reuse the
# key the deployed Worker already signs with, or existing subscriptions break.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Pin the stage. Alchemy otherwise defaults to live_${USER}. `demo` is the
# stage the existing deployment uses.
ALCHEMY_STAGE=demo

# `off` deploys without R2/backups (for accounts where R2 is not enabled).
TALI_BACKUPS=on

# Capture (ADR-0012). The key is an OpenCode Go key; the Go gateway root is
# `/inference/go`, not the pay-as-you-go `/inference` root. The feature is inert
# without the key: every Dissect fails with a typed ModelUnavailable.
OPENCODE_API_KEY=
CAPTURE_BASE_URL=https://opencode.ai/inference/go/openai/v1
CAPTURE_MODEL=deepseek-v4.1-flash

# Observability (ADR-0013). Workers Logs and Traces are on by default. Traces
# are head-sampled at 0.1 (10%); set 0..1 here to change it. Seven-day
# retention; persisted traces are billable from 2026-12-01.
TALI_TRACE_SAMPLE_RATE=0.1

# `accept` adopts the browser's incoming traceparent so the Foldkit Command
# spans and the api spans share one trace ID. Requires trace propagation to be
# enabled on the Cloudflare account; leave empty otherwise.
TALI_TRACE_PROPAGATION=

# Optional OTLP export (Grafana/Honeycomb/Axiom). Leave both URLs empty to keep
# observability in the Workers dashboard only. HEADERS is a JSON object.
TALI_OTLP_TRACES_URL=
# TALI_OTLP_TRACES_HEADERS={"authorization":"Bearer …"}
# TALI_OTLP_TRACES_SKIP_PREFLIGHT=0
TALI_OTLP_LOGS_URL=
# TALI_OTLP_LOGS_HEADERS={"authorization":"Bearer …"}
# TALI_OTLP_LOGS_SKIP_PREFLIGHT=0

# Browser span export (build-time). Leave empty to keep Foldkit Command spans
# local; set a browser-scoped OTLP endpoint to export redacted spans. A header
# value is visible in the bundle: never reuse a server token.
VITE_OTLP_TRACES_URL=
# VITE_OTLP_TRACES_HEADERS={"authorization":"Bearer …"}
