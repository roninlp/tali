# Copy to .env and fill in. The infra package scripts load it automatically for
# `pnpm stack:plan`, `pnpm stack:deploy`, `pnpm stack:destroy` and `pnpm dev`:
#
#   cp .env.example .env
#   pnpm stack:plan
#   pnpm stack:deploy
#
# `.env` is gitignored. The same names are GitHub Actions secrets for the
# deploy-on-push workflow (see infra/README.md).

# Cloudflare account + API token (Workers Scripts, D1, Workers R2 Storage edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The existing Web Push identity. Generate a dev pair with
# `pnpm exec web-push generate-vapid-keys`; a production deploy must reuse the
# key the deployed Worker already signs with, or existing subscriptions break.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Pin the stage. Alchemy otherwise defaults to live_${USER}. `demo` is the
# stage the existing deployment uses.
ALCHEMY_STAGE=demo

# `off` deploys without R2/backups (for accounts where R2 is not enabled).
TALI_BACKUPS=on
