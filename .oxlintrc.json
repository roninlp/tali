{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@tali/lint-config/oxlint/base.json"],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".turbo",
    ".agents",
    "repos",
    "patches",
    "packages/lint-config/anti-slop",
    "packages/e2e/playwright-report",
    "packages/e2e/test-results",
    "packages/e2e/.state",
    "**/*.d.ts",
    "pnpm-lock.yaml"
  ]
}
