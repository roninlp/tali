{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["TZ"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "TALI_BACKUPS"
      ]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "TALI_BACKUPS"
      ]
    },
    "plan": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "TALI_BACKUPS"
      ]
    },
    "destroy": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "TALI_BACKUPS"
      ]
    }
  }
}
