{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#lint": {
      "inputs": ["!pnpm-lock.yaml"]
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TZ"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "OPENCODE_API_KEY",
        "CAPTURE_BASE_URL",
        "CAPTURE_MODEL",
        "TALI_BACKUPS",
        "TALI_TRACE_SAMPLE_RATE",
        "TALI_TRACE_PROPAGATION",
        "TALI_OTLP_TRACES_URL",
        "TALI_OTLP_TRACES_HEADERS",
        "TALI_OTLP_TRACES_SKIP_PREFLIGHT",
        "TALI_OTLP_LOGS_URL",
        "TALI_OTLP_LOGS_HEADERS",
        "TALI_OTLP_LOGS_SKIP_PREFLIGHT",
        "VITE_OTLP_TRACES_URL",
        "VITE_OTLP_TRACES_HEADERS"
      ]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "OPENCODE_API_KEY",
        "CAPTURE_BASE_URL",
        "CAPTURE_MODEL",
        "TALI_BACKUPS",
        "TALI_TRACE_SAMPLE_RATE",
        "TALI_TRACE_PROPAGATION",
        "TALI_OTLP_TRACES_URL",
        "TALI_OTLP_TRACES_HEADERS",
        "TALI_OTLP_TRACES_SKIP_PREFLIGHT",
        "TALI_OTLP_LOGS_URL",
        "TALI_OTLP_LOGS_HEADERS",
        "TALI_OTLP_LOGS_SKIP_PREFLIGHT",
        "VITE_OTLP_TRACES_URL",
        "VITE_OTLP_TRACES_HEADERS"
      ]
    },
    "plan": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "OPENCODE_API_KEY",
        "CAPTURE_BASE_URL",
        "CAPTURE_MODEL",
        "TALI_BACKUPS",
        "TALI_TRACE_SAMPLE_RATE",
        "TALI_TRACE_PROPAGATION",
        "TALI_OTLP_TRACES_URL",
        "TALI_OTLP_TRACES_HEADERS",
        "TALI_OTLP_TRACES_SKIP_PREFLIGHT",
        "TALI_OTLP_LOGS_URL",
        "TALI_OTLP_LOGS_HEADERS",
        "TALI_OTLP_LOGS_SKIP_PREFLIGHT",
        "VITE_OTLP_TRACES_URL",
        "VITE_OTLP_TRACES_HEADERS"
      ]
    },
    "destroy": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_KEY",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_ACCOUNT_EMAIL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "OPENCODE_API_KEY",
        "CAPTURE_BASE_URL",
        "CAPTURE_MODEL",
        "TALI_BACKUPS",
        "TALI_TRACE_SAMPLE_RATE",
        "TALI_TRACE_PROPAGATION",
        "TALI_OTLP_TRACES_URL",
        "TALI_OTLP_TRACES_HEADERS",
        "TALI_OTLP_TRACES_SKIP_PREFLIGHT",
        "TALI_OTLP_LOGS_URL",
        "TALI_OTLP_LOGS_HEADERS",
        "TALI_OTLP_LOGS_SKIP_PREFLIGHT",
        "VITE_OTLP_TRACES_URL",
        "VITE_OTLP_TRACES_HEADERS"
      ]
    }
  }
}
