{
  "name": "tali",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "vp run -r --cache build",
    "typecheck": "vp run -r --cache typecheck",
    "lint": "vp lint --ignore-pattern 'repos/**' --deny-warnings . && pnpm lint:effect",
    "lint:effect": "effect-tsgo patch --no-typescript --oxlint && vp lint --config packages/lint-config/oxlint/effect-typed.ts --deny-warnings apps/web-foldkit/src",
    "test": "TZ=UTC vp run -r --cache test",
    "test:e2e": "pnpm --filter @tali/e2e test:e2e",
    "dev": "vp run -r dev",
    "dev:foldkit": "pnpm --filter @tali/web-foldkit dev",
    "quality": "pnpm lint && pnpm format",
    "quality:fix": "pnpm lint:fix && pnpm format:fix",
    "stack:plan": "pnpm --filter @tali/infra run plan",
    "stack:deploy": "pnpm --filter @tali/infra run deploy",
    "stack:destroy": "pnpm --filter @tali/infra run destroy",
    "test:push": "node scripts/test-push.mjs",
    "eval:capture": "node scripts/eval-capture.mjs",
    "test:smoke:foldkit": "pnpm --filter @tali/e2e test:smoke:foldkit",
    "test:smoke:foldkit:sync": "pnpm --filter @tali/e2e test:smoke:foldkit:sync",
    "stack:ci": "pnpm --filter @tali/infra run github",
    "lint:fix": "vp lint --ignore-pattern 'repos/**' --fix . && pnpm lint:effect",
    "format": "vp fmt --check",
    "format:fix": "vp fmt ."
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@tali/lint-config": "workspace:*",
    "typescript": "catalog:",
    "web-push": "^3.6.7",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
